<?xml version="1.0" encoding="utf-8"?>
<!-- The shell's own native text (the rest is in packages/shell's catalog, shown by local pages).
     The unsupported state is native (R9, R17): an old WebView may not run the local pages. -->
<resources>
    <string name="unsupported_title">This device’s WebView is too old</string>
    <string name="unsupported_body">Update Android System WebView (or Chrome) from the Play Store, then open the app again. Until then no platform can be opened here.</string>
    <!-- Managed configurations (res/xml/app_restrictions.xml), shown in an MDM console. -->
    <string name="restriction_preset_url_title">Platform address</string>
    <string name="restriction_preset_url_description">The https address of the Capybara platform the app opens.</string>
    <string name="restriction_lock_title">Only this platform</string>
    <string name="restriction_lock_description">Hide other platforms and refuse adding them. Needs a platform address, here or in the app build.</string>
    <!-- The notification channel of pushes (push/PushModule.kt), shown in the system settings. -->
    <string name="push_channel_name">Notifications</string>
</resources>
