# Release lanes of the mobile app. Secrets arrive only as environment variables (the workflow maps
# them from a GitHub environment); nothing here prints them. Run from apps/mobile:
#   bundle exec fastlane ios beta        (TestFlight; uploads only with UPLOAD=true)
#   bundle exec fastlane android release (signed APK and AAB)
#   bundle exec fastlane android internal (Play internal track)
default_platform(:ios)

APP_ROOT = File.expand_path("..", __dir__)
OUTPUT_DIR = File.join(APP_ROOT, "release")

def truthy?(name)
  %w[1 true yes].include?(ENV[name].to_s.downcase)
end

def build_number
  ENV.fetch("BUILD_NUMBER") { UI.user_error!("BUILD_NUMBER is not set (the workflow passes github.run_number)") }
end

def required_env(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} is not set") if value.empty?
  value
end

platform :ios do
  desc "Build a signed IPA and, with UPLOAD=true, upload it to TestFlight"
  lane :beta do
    setup_ci

    app_store_connect_api_key(
      key_id: required_env("APPLE_API_KEY_ID"),
      issuer_id: required_env("APPLE_API_ISSUER_ID"),
      key_content: required_env("APPLE_API_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    import_certificate(
      certificate_path: required_env("IOS_DIST_CERT_P12_PATH"),
      certificate_password: required_env("IOS_DIST_CERT_PASSWORD"),
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"],
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"].to_s
    )

    profile_path = required_env("IOS_PROVISIONING_PROFILE_PATH")
    install_provisioning_profile(path: profile_path)
    profile_plist = sh("security cms -D -i '#{profile_path}'", log: false)
    plist_path = File.join(Dir.tmpdir, "capybara-profile.plist")
    File.write(plist_path, profile_plist)
    profile_name = sh("plutil -extract Name raw '#{plist_path}'", log: false).strip
    team_id = sh("plutil -extract TeamIdentifier.0 raw '#{plist_path}'", log: false).strip
    File.delete(plist_path)

    app_id = ENV["CAPYBARA_APP_ID"] || "com.capybarahq.mobile"
    build_app(
      project: File.join(APP_ROOT, "ios/App/App.xcodeproj"),
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUTPUT_DIR,
      output_name: "Capybara.ipa",
      export_options: { provisioningProfiles: { app_id => profile_name } },
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "DEVELOPMENT_TEAM=#{team_id}",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
      ].join(" ")
    )

    if truthy?("UPLOAD")
      upload_to_testflight(skip_waiting_for_build_processing: true)
    else
      UI.important("UPLOAD is not true: the IPA stays a build artifact")
    end
  end
end

platform :android do
  desc "Signed release APK and AAB (the keystore comes from CAPYBARA_KEYSTORE_* variables)"
  lane :release do
    ["CAPYBARA_KEYSTORE_PATH", "CAPYBARA_KEYSTORE_PASSWORD", "CAPYBARA_KEY_ALIAS", "CAPYBARA_KEY_PASSWORD"].each do |name|
      required_env(name)
    end
    gradle(
      project_dir: File.join(APP_ROOT, "android"),
      tasks: ["assembleRelease", "bundleRelease"],
      properties: { "capybaraVersionCode" => build_number }
    )
  end

  desc "Upload the signed AAB to the Play internal track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: File.join(APP_ROOT, "android/app/build/outputs/bundle/release/app-release.aab"),
      json_key_data: required_env("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
