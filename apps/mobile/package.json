{
  "name": "@capybara-hq/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "sync": "node scripts/build.ts && cap sync",
    "test:ios": "scripts/ios-test.sh AppTests",
    "test:ios:ui": "scripts/ios-test.sh AppUITests",
    "test:ios:all": "scripts/ios-test.sh AppTests AppUITests",
    "test:android": "node scripts/build.ts && cap sync android && cd android && ./gradlew :app:testDebugUnitTest",
    "test:android:device": "node scripts/build.ts && cap sync android && cd android && ./gradlew :app:connectedDebugAndroidTest",
    "apply-brand": "node scripts/apply-brand.ts",
    "check:brand": "node scripts/apply-brand.ts --check"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capybara-hq/shell": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@capybara-hq/plugin-sdk": "0.1.0-rc.44",
    "esbuild": "^0.28.2"
  }
}
