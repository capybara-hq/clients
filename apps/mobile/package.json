{
  "name": "@capybara-hq/mobile",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "sync": "node scripts/build.ts && cap sync",
    "test:ios": "scripts/ios-test.sh AppTests",
    "test:ios:ui": "scripts/ios-test.sh AppUITests",
    "test:android": "cd android && ./gradlew :app:testDebugUnitTest",
    "test:android:device": "node scripts/build.ts && cap sync android && cd android && ./gradlew :app:connectedDebugAndroidTest",
    "check:brand": "node scripts/apply-brand.ts --check"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "^0.28.2"
  }
}
